{"language": "zig", "version": "1.0", "description": "Zig language FFI boundary patterns - extern, allocator, c_import safety", "functions": [{"pattern": "Allocator.alloc", "match_type": "contains", "kind": "zig_allocator", "severity": "medium", "consumes_ownership": false, "transfers_ownership": true, "requires_null_check": true, "requires_taint_check": false, "description": "Zig allocator allocation - returns owned memory"}, {"pattern": "allocImpl", "match_type": "contains", "kind": "zig_allocator", "severity": "medium", "consumes_ownership": false, "transfers_ownership": true, "requires_null_check": true, "requires_taint_check": false, "description": "Zig allocator implementation - returns owned memory"}, {"pattern": "free", "match_type": "exact", "kind": "zig_allocator", "severity": "high", "consumes_ownership": true, "transfers_ownership": false, "requires_null_check": false, "requires_taint_check": false, "description": "Zig allocator free - consumes ownership"}], "stdlib_prefixes": ["std.", "zig_", "__zig", "std.heap.", "std.debug.", "std.mem."], "noise_prefixes": ["@import", "@cImport", "@extern"], "compiler_reserved": ["__zig_lt_errors_len", "__zig_probe_stack", "__zig_tag_name_", "__zig_is_named_enum_value_", "__zig_err_name_table", "__sancov_gen_", "__floatuntisf", "__fixsfsi", "__gesf2", "__truncdfhf2", "__extendhfsf2", "__addsf3", "__mulsf3"], "allocator_strategy": "vtable_indirect", "allocator_detection_note": "Zig allocators are vtable-based indirect calls. Look for indirect calls through function pointer tables. PageAllocator calls appear as OS primitives (mmap, NtAllocateVirtualMemory, sbrk). No standard malloc/free unless explicitly using C allocator. Comptime allocations invisible in IR.", "escape_patterns": ["@extern", "c_import"]}